    local flingBtn = make("TextButton", {Size = UDim2.new(1, -10, 0, 34), BackgroundColor3 = Color3.fromRGB(25, 25, 32), TextColor3 = Color3.fromRGB(220, 220, 220), Text = "Бесконечный Fling (До смерти): ВЫКЛ", Font = Enum.Font.GothamBold, TextSize = 12, LayoutOrder = 30}, vVip) addCorner(flingBtn, 6)

    flingBtn.MouseButton1Click:Connect(function()
        if isFling then 
            stopFling() 
            flingBtn.Text = "Бесконечный Fling (До смерти): ВЫКЛ"
            tween(flingBtn, 0.2, {BackgroundColor3 = Color3.fromRGB(25, 25, 32)})
        else
            local t = getTarget(flingInp.Text)
            if t then
                startFling(t)
                flingBtn.Text = "Flinging: " .. t.Name
                tween(flingBtn, 0.2, {BackgroundColor3 = Color3.fromRGB(150, 50, 200)})
            else showNotice("⚠️ Игрок не найден!") end
        end
    end)

    setAntiFlingState = CreateToggleWithBind(vVip, "Anti-Fling (Защита)", "VIP_AntiFling", false, function(state) isAntiFling = state end)

    RS.Stepped:Connect(function()
        if isAntiFling then
            pcall(function()
                for _, p in ipairs(game.Players:GetPlayers()) do
                    if p ~= player and p.Character then
                        for _, v in ipairs(p.Character:GetChildren()) do if v:IsA("BasePart") then v.CanCollide = false end end
                    end
                end
                local char = player.Character
                if char and char.Parent then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Velocity.Magnitude > 250 or hrp.RotVelocity.Magnitude > 250) then
                        hrp.Velocity = Vector3.zero hrp.RotVelocity = Vector3.zero
                    end
                end
            end)
        end
    end)

    local isFreecam = false
    local fcPart = nil
    local fcConn = nil
    CreateToggleWithBind(vVip, "🎥 Свободная камера (Freecam)", "VIP_Freecam", false, function(state)
        isFreecam = state
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if isFreecam then
            if hrp then hrp.Anchored = true end
            fcPart = Instance.new("Part")
            fcPart.Transparency = 1 fcPart.CanCollide = false fcPart.Anchored = true
            fcPart.Position = workspace.CurrentCamera.CFrame.Position fcPart.Parent = workspace
            workspace.CurrentCamera.CameraSubject = fcPart
            
            local speed = 50
            fcConn = RS.RenderStepped:Connect(function(dt)
                local cam = workspace.CurrentCamera
                local moveDir = Vector3.new()
                if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.E) then moveDir = moveDir + cam.CFrame.UpVector end
                if UIS:IsKeyDown(Enum.KeyCode.Q) then moveDir = moveDir - cam.CFrame.UpVector end
                
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then speed = 100 else speed = 50 end
                
                if moveDir.Magnitude > 0 then fcPart.Position = fcPart.Position + (moveDir.Unit * speed * dt) end
                fcPart.CFrame = CFrame.new(fcPart.Position, fcPart.Position + cam.CFrame.LookVector)
            end)
            showNotice("Свободная камера включена! (WASD - летать, Q/E - вверх/вниз)")
        else
            if hrp then hrp.Anchored = false end
            if fcConn then fcConn:Disconnect() end
            if fcPart then fcPart:Destroy() end
            if player.Character and player.Character:FindFirstChild("Humanoid") then workspace.CurrentCamera.CameraSubject = player.Character.Humanoid end
            showNotice("Свободная камера выключена")
        end
    end)
end

-- ================== 5. ПРОЧЕЕ ==================
do
    CreateLabel(vOther, "Утилиты", 0)
    
    local fResetCont = make("Frame", {Size = UDim2.new(1, -10, 0, 34), BackgroundTransparency = 1, LayoutOrder = 1}, vOther)
    local fastResetBtn = make("TextButton", {Size = UDim2.new(1, -50, 1, 0), BackgroundColor3 = Color3.fromRGB(180, 50, 50), TextColor3 = Color3.fromRGB(255, 255, 255), Text = "💀 Быстрый Ресет (Возврат)", Font = Enum.Font.GothamBold, TextSize = 12}, fResetCont) addCorner(fastResetBtn, 6)
    local fastResetBindBtn = make("TextButton", {Size = UDim2.new(0, 45, 1, 0), Position = UDim2.new(1, -45, 0, 0), BackgroundColor3 = Color3.fromRGB(35, 35, 45), Font = Enum.Font.GothamBold, TextSize = 11}, fResetCont) addCorner(fastResetBindBtn, 6)
    
    setupBind(fastResetBindBtn, "Other_FastReset")

    doFastReset = function()
        pcall(function()
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                fastResetCFrame = char.HumanoidRootPart.CFrame
                isFastResetting = true char.Humanoid.Health = 0 showNotice("Ресет... Возвращаем обратно!")
            end
        end)
    end
    fastResetBtn.MouseButton1Click:Connect(doFastReset)

    -- BHOP
    CreateLabel(vOther, "Модификаторы Движения", 2)
    local isBhop = false
    local currentBhopSpeed = 16
    local timeOnGround = 0

    CreateToggleWithBind(vOther, "🐰 Bhop (Ускорение при прыжках)", "Other_Bhop", false, function(state)
        isBhop = state
        if not isBhop and player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
            player.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = mySetts.targetSpeed or 16
        end
    end, 3)

    RS.RenderStepped:Connect(function(dt)
        if isBhop then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local inAir = (hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.Jumping)
                local isMoving = hum.MoveDirection.Magnitude > 0
                local baseSpeed = mySetts.targetSpeed or 16

                if not inAir then
                    timeOnGround = timeOnGround + dt
                    -- Увеличили время до 0.5 секунд, чтобы комбо не сбрасывалось при резких поворотах
                    if timeOnGround > 0.5 then
                        currentBhopSpeed = baseSpeed
                    end
                    if isMoving and UIS:IsKeyDown(Enum.KeyCode.Space) then
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        currentBhopSpeed = math.min(100, currentBhopSpeed + 8)
                        timeOnGround = 0
                    end
                else
                    timeOnGround = 0
                end
                
                hum.WalkSpeed = currentBhopSpeed

                -- МОМЕНТАЛЬНЫЙ СТРЕЙФ В ВОЗДУХЕ (Как в CS:GO)
                if isMoving and inAir then
                    local dir = hum.MoveDirection
                    local flatVel = dir * currentBhopSpeed
                    hrp.Velocity = Vector3.new(flatVel.X, hrp.Velocity.Y, flatVel.Z)
                end
            end
        end
    end)

    CreateLabel(vOther, "Маршрутный Тестер (Auto-Walk)", 4)
    local rtPointsContainer = Instance.new("Frame")
    rtPointsContainer.Size = UDim2.new(1, 0, 0, 0)
    rtPointsContainer.AutomaticSize = Enum.AutomaticSize.Y
    rtPointsContainer.BackgroundTransparency = 1
    rtPointsContainer.LayoutOrder = 5
    rtPointsContainer.Parent = vOther
    make("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder}, rtPointsContainer)

    local rtPoints = {}
    local rtIsLooping = false
    local rtIsMoving = false
    local rtCurrentTween = nil

    local function parseCoords(str)
        local coords = {}
        for val in string.gmatch(str, "([^,]+)") do table.insert(coords, tonumber(val)) end
        return #coords == 3 and Vector3.new(coords[1], coords[2], coords[3]) or nil
    end

    local function createPointRow()
        local Row = make("Frame", {Size = UDim2.new(1, -10, 0, 34), BackgroundColor3 = Color3.fromRGB(25, 25, 32)}, rtPointsContainer) addCorner(Row, 6)
        local Inp = make("TextBox", {Size = UDim2.new(0.55, -5, 1, 0), Position = UDim2.new(0, 5, 0, 0), BackgroundTransparency=1, TextColor3 = Color3.fromRGB(255,255,255), PlaceholderText = "X, Y, Z", Text = "", Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, Row)
        local getBtn = make("TextButton", {Size = UDim2.new(0.2, 0, 0, 24), Position = UDim2.new(0.6, 0, 0.5, -12), BackgroundColor3 = Color3.fromRGB(40, 120, 200), TextColor3 = Color3.fromRGB(255,255,255), Text = "Тут", Font = Enum.Font.GothamBold, TextSize = 11}, Row) addCorner(getBtn, 4)
        local delBtn = make("TextButton", {Size = UDim2.new(0.15, 0, 0, 24), Position = UDim2.new(0.82, 0, 0.5, -12), BackgroundColor3 = Color3.fromRGB(180, 50, 50), TextColor3 = Color3.fromRGB(255,255,255), Text = "X", Font = Enum.Font.GothamBold, TextSize = 11}, Row) addCorner(delBtn, 4)

        local entry = {Input = Inp} table.insert(rtPoints, entry)

        getBtn.MouseButton1Click:Connect(function()
            local c = player.Character if c and c:FindFirstChild("HumanoidRootPart") then Inp.Text = string.format("%.1f, %.1f, %.1f", c.HumanoidRootPart.Position.X, c.HumanoidRootPart.Position.Y, c.HumanoidRootPart.Position.Z) end
        end)
        delBtn.MouseButton1Click:Connect(function()
            for i, v in ipairs(rtPoints) do if v == entry then table.remove(rtPoints, i) break end end Row:Destroy()
        end)
    end
    createPointRow() createPointRow()

    CreateButton(vOther, "+ Добавить точку", createPointRow, Color3.fromRGB(40, 120, 200), 6)
    local rtSpeedInp = CreateTextBox(vOther, "Время пути между точками (сек)", "2", 7)
    CreateToggleWithBind(vOther, "Зациклить маршрут", "Other_LoopRoute", false, function(state) rtIsLooping = state end, 8)

    CreateButton(vOther, "▶ ЗАПУСТИТЬ / СТОП МАРШРУТ", function()
        if rtIsMoving then
            rtIsMoving = false if rtCurrentTween then rtCurrentTween:Cancel() rtCurrentTween = nil end showNotice("Маршрут остановлен!") return
        end
        
        local validPoints = {}
        for _, entry in ipairs(rtPoints) do
            local pos = parseCoords(entry.Input.Text)
            if pos then table.insert(validPoints, pos) end
        end
        
        if #validPoints < 2 then showNotice("⚠️ Нужно минимум 2 точки!") return end
        rtIsMoving = true showNotice("Маршрут запущен!")
        local duration = tonumber(rtSpeedInp.Text) or 2

        task.spawn(function()
            while rtIsMoving do
                for i, targetPos in ipairs(validPoints) do
                    if not rtIsMoving then break end
                    local char = player.Character local root = char and char:FindFirstChild("HumanoidRootPart")
                    if not root then rtIsMoving = false break end
                    
                    if i == 1 and not rtCurrentTween then root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                    else
                        rtCurrentTween = TS:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))})
                        rtCurrentTween:Play() rtCurrentTween.Completed:Wait()
                    end
                end
                if not rtIsLooping then rtIsMoving = false break end
            end
            showNotice("Маршрут завершен.")
        end)
    end, Color3.fromRGB(40, 160, 60), 9)
end

