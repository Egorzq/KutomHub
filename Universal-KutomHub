        rtIsLooping = not rtIsLooping rtLoopBtn.Text = rtIsLooping and "Цикл: ВКЛ" or "Цикл: ВЫКЛ" tween(rtLoopBtn, 0.2, {BackgroundColor3 = rtIsLooping and C3(180, 100, 0) or C3(100, 100, 100)})
    end)

    local rtStartBtn = make("TextButton", {Size = U2(1, -10, 0, 34), BackgroundColor3 = C3(40, 160, 60), TextColor3 = C3(255, 255, 255), Text = "▶ ЗАПУСТИТЬ МАРШРУТ", Font = Enum.Font.GothamBold, TextSize = 12, LayoutOrder = 7}, vOther) addCorner(rtStartBtn, 6)

    local function stopRtMoving()
        rtIsMoving = false if rtCurrentTween then rtCurrentTween:Cancel() rtCurrentTween = nil end rtStartBtn.Text = "▶ ЗАПУСТИТЬ МАРШРУТ" tween(rtStartBtn, 0.2, {BackgroundColor3 = C3(40, 160, 60)})
    end

    rtStartBtn.MouseButton1Click:Connect(function()
        if rtIsMoving then stopRtMoving() return end
        
        local validPoints = {}
        for _, entry in ipairs(rtPoints) do
            local pos = parseCoords(entry.Input.Text)
            if pos then table.insert(validPoints, pos) end
        end
        
        if #validPoints < 2 then showNotice("⚠️ Нужно минимум 2 точки!") return end
        rtIsMoving = true rtStartBtn.Text = "⏹ СТОП" tween(rtStartBtn, 0.2, {BackgroundColor3 = C3(180, 50, 50)})
        local duration = tonumber(rtSpeedInp.Text) or 2

        task.spawn(function()
            while rtIsMoving do
                for i, targetPos in ipairs(validPoints) do
                    if not rtIsMoving then break end
                    local char = player.Character local root = char and char:FindFirstChild("HumanoidRootPart")
                    if not root then stopRtMoving() break end
                    
                    if i == 1 and not rtCurrentTween then root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                    else
                        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                        rtCurrentTween = TS:Create(root, tweenInfo, {CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))})
                        rtCurrentTween:Play() rtCurrentTween.Completed:Wait()
                    end
                end
                if not rtIsLooping then stopRtMoving() break end
            end
        end)
    end)

    task.spawn(function()
        while task.wait(0.1) do
            pcall(function()
                local c = player.Character if c and c:FindFirstChild("HumanoidRootPart") then rtPosLabel.Text = string.format("Позиция: %.1f, %.1f, %.1f", c.HumanoidRootPart.Position.X, c.HumanoidRootPart.Position.Y, c.HumanoidRootPart.Position.Z) end
            end)
        end
    end)
end

