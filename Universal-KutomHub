do
    local EmotesTop = make("Frame", {Size = UDim2.new(1, -10, 0, 30), BackgroundTransparency = 1}, vEmotes)
    local btnTabSearch = make("TextButton", {Size = UDim2.new(0.5, -5, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 120, 200), Text = "🔍 Поиск", TextColor3 = Color3.fromRGB(255,255,255), Font = Enum.Font.GothamBold, TextSize = 12}, EmotesTop) addCorner(btnTabSearch, 6)
    local btnTabSaved = make("TextButton", {Size = UDim2.new(0.5, -5, 1, 0), Position = UDim2.new(0.5, 5, 0, 0), BackgroundColor3 = Color3.fromRGB(25, 25, 32), Text = "⭐ Сохраненные", TextColor3 = Color3.fromRGB(200,200,200), Font = Enum.Font.GothamBold, TextSize = 12}, EmotesTop) addCorner(btnTabSaved, 6)

    local vEmotesSearch = make("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -35), Position = UDim2.new(0, 0, 0, 35), BackgroundTransparency = 1, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0,0,0,0)}, vEmotes)
    local vEmotesSaved = make("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -35), Position = UDim2.new(0, 0, 0, 35), BackgroundTransparency = 1, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0,0,0,0), Visible = false}, vEmotes)

    btnTabSearch.MouseButton1Click:Connect(function()
        vEmotesSearch.Visible = true vEmotesSaved.Visible = false
        tween(btnTabSearch, 0.2, {BackgroundColor3 = Color3.fromRGB(40, 120, 200), TextColor3 = Color3.fromRGB(255,255,255)})
        tween(btnTabSaved, 0.2, {BackgroundColor3 = Color3.fromRGB(25, 25, 32), TextColor3 = Color3.fromRGB(200,200,200)})
    end)
    btnTabSaved.MouseButton1Click:Connect(function()
        vEmotesSaved.Visible = true vEmotesSearch.Visible = false
        tween(btnTabSaved, 0.2, {BackgroundColor3 = Color3.fromRGB(40, 120, 200), TextColor3 = Color3.fromRGB(255,255,255)})
        tween(btnTabSearch, 0.2, {BackgroundColor3 = Color3.fromRGB(25, 25, 32), TextColor3 = Color3.fromRGB(200,200,200)})
    end)

    -- ФУНКЦИИ ВОСПРОИЗВЕДЕНИЯ
    local isLoopAnim = true
    playAnim = function(id)
        local char = player.Character if not char then return end 
        local hum = char:FindFirstChildOfClass("Humanoid") if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
        
        for _, track in ipairs(anim:GetPlayingAnimationTracks()) do track:Stop() end
        if currentAnimId == id then currentAnimId = nil return end
        
        local animIdToPlay = string.match(id, "^rbxassetid://") and id or "rbxassetid://"..id
        pcall(function()
            local rawId = string.match(id, "%d+")
            local objects = game:GetObjects("rbxassetid://" .. rawId)
            if objects and objects[1] then
                local animObj = objects[1]:IsA("Animation") and objects[1] or objects[1]:FindFirstChildWhichIsA("Animation", true)
                if animObj then animIdToPlay = animObj.AnimationId end
            end
        end)
        
        local a = Instance.new("Animation") 
        a.AnimationId = animIdToPlay
        currentAnimTrack = anim:LoadAnimation(a) 
        currentAnimTrack.Priority = Enum.AnimationPriority.Action 
        currentAnimTrack.Looped = isLoopAnim 
        currentAnimTrack:Play() 
        currentAnimId = id
    end

    make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)}, vEmotesSearch)
    local searchRow = make("Frame", {Size = UDim2.new(1, -10, 0, 35), BackgroundTransparency = 1, LayoutOrder = 1}, vEmotesSearch)
    local searchInp = make("TextBox", {Size = UDim2.new(0.65, -5, 1, 0), BackgroundColor3 = Color3.fromRGB(20, 20, 26), PlaceholderText = "Англ. название (напр: Dance)...", Text = "", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.Gotham, TextSize = 12}, searchRow) addCorner(searchInp, 6)
    local searchBtn = make("TextButton", {Size = UDim2.new(0.35, 0, 1, 0), Position = UDim2.new(0.65, 5, 0, 0), BackgroundColor3 = Color3.fromRGB(150, 50, 200), Text = "Искать", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 12}, searchRow) addCorner(searchBtn, 6)
    
    local searchResultsContainer = make("Frame", {Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2}, vEmotesSearch)
    make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5)}, searchResultsContainer)
    
    local function renderEmotesUI() end

    searchBtn.MouseButton1Click:Connect(function()
        for _, child in ipairs(searchResultsContainer:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
        local q = searchInp.Text
        if q == "" then return end
        showNotice("Ищем в каталоге...")
        
        task.spawn(function()
            local success, result = pcall(function()
                local searchParams = CatalogSearchParams.new()
                searchParams.SearchKeyword = q
                searchParams.AssetTypes = {Enum.AvatarAssetType.EmoteAnimation}
                searchParams.SortType = Enum.CatalogSortType.Relevance
                return AvatarEditorService:SearchCatalog(searchParams)
            end)
            
            if success and result then
                local items = result:GetCurrentPage()
                if #items > 0 then
                    showNotice("Найдено: " .. #items)
                    for _, item in ipairs(items) do
                        local assetId = item.Id
                        local name = item.Name
                        
                        local Row = make("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = Color3.fromRGB(25, 25, 32)}, searchResultsContainer) addCorner(Row, 6)
                        local Icon = make("ImageLabel", {Size = UDim2.new(0, 36, 0, 36), Position = UDim2.new(0, 4, 0.5, -18), BackgroundColor3 = Color3.fromRGB(40,40,45), BackgroundTransparency = 0, Image = "rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=150&h=150"}, Row) addCorner(Icon, 6)
                        local nameLbl = make("TextLabel", {Size = UDim2.new(0.5, -45, 1, 0), Position = UDim2.new(0, 45, 0, 0), BackgroundTransparency=1, TextColor3=Color3.fromRGB(255,255,255), Text=name, Font=Enum.Font.Gotham, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd}, Row)
                        
                        local playCatBtn = make("TextButton", {Size=UDim2.new(0.2, 0, 0, 28), Position=UDim2.new(0.55, 0, 0.5, -14), BackgroundColor3=Color3.fromRGB(40,120,200), Text="▶ Играть", TextColor3=Color3.fromRGB(255,255,255), Font=Enum.Font.GothamBold, TextSize=10}, Row) addCorner(playCatBtn, 4)
                        local saveCatBtn = make("TextButton", {Size=UDim2.new(0.2, 0, 0, 28), Position=UDim2.new(0.78, 0, 0.5, -14), BackgroundColor3=Color3.fromRGB(40,160,60), Text="➕ Сохр.", TextColor3=Color3.fromRGB(255,255,255), Font=Enum.Font.GothamBold, TextSize=10}, Row) addCorner(saveCatBtn, 4)
                        
                        playCatBtn.MouseButton1Click:Connect(function() playAnim(tostring(assetId)) end)
                        saveCatBtn.MouseButton1Click:Connect(function() 
                            local idStr = tostring(assetId)
                            local exists = false
                            for _, v in ipairs(customAnims) do if v.id == idStr then exists = true break end end
                            if not exists then 
                                table.insert(customAnims, {name = name, id = idStr}) 
                                saveData() renderEmotesUI() showNotice("Сохранено!") 
                            else showNotice("Уже в списке!") end
                        end)
                    end
                else showNotice("Ничего не найдено!") end
            else showNotice("Сбой поиска в каталоге!") end
        end)
    end)

    make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)}, vEmotesSaved)
    CreateToggleWithBind(vEmotesSaved, "Зациклить эмоции", "Emotes_Loop", true, function(state)
        isLoopAnim = state
        if currentAnimTrack then currentAnimTrack.Looped = isLoopAnim end
    end, 1)

    CreateButton(vEmotesSaved, "⏹ Остановить анимацию", function()
        if currentAnimTrack then currentAnimTrack:Stop() currentAnimTrack = nil end
        currentAnimId = nil
        local char = player.Character 
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                local animator = hum:FindFirstChildOfClass("Animator")
                if animator then for _, track in ipairs(animator:GetPlayingAnimationTracks()) do if track.Priority == Enum.AnimationPriority.Action then track:Stop() end end end
            end
        end
    end, Color3.fromRGB(180, 50, 50), 2)

    local emotesContainer = make("Frame", {Size = UDim2.new(1,-10,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3}, vEmotesSaved)
    make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5)}, emotesContainer)

    local function createEmoteRow(name, id, isCust)
        local Row = make("Frame", {Size = UDim2.new(1, 0, 0, 35), BackgroundTransparency = 1}, emotesContainer)
        local PlayBtn = make("TextButton", {Size = UDim2.new(1, -85, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 40, 48), Text = "⭐ " .. name, TextColor3 = Color3.fromRGB(220, 220, 220), Font = Enum.Font.GothamSemibold, TextSize = 13}, Row) addCorner(PlayBtn, 6)
        local BindBtn = make("TextButton", {Size = UDim2.new(0, 35, 1, 0), Position = UDim2.new(1, -80, 0, 0), BackgroundColor3 = Color3.fromRGB(60, 60, 70), Font = Enum.Font.GothamBold, TextSize = 11}, Row) addCorner(BindBtn, 6)

        setupBind(BindBtn, id)
        PlayBtn.MouseButton1Click:Connect(function() playAnim(id) end)

        local DelBtn = make("TextButton", {Size = UDim2.new(0, 35, 1, 0), Position = UDim2.new(1, -40, 0, 0), BackgroundColor3 = Color3.fromRGB(180, 50, 50), Text = "🗑️", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 12}, Row) addCorner(DelBtn, 6)
        DelBtn.MouseButton1Click:Connect(function() 
            for i, v in ipairs(customAnims) do if v.id == id then table.remove(customAnims, i) break end end 
            binds[id] = nil saveData() Row:Destroy()
        end)
    end

    renderEmotesUI = function()
        for _, child in ipairs(emotesContainer:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
        for _, v in ipairs(customAnims) do createEmoteRow(v.name, v.id, true) end
    end
    renderEmotesUI()

    CreateLabel(vEmotesSaved, "Добавить свою эмоцию вручную", 4)
    local emoNameInp = CreateTextBox(vEmotesSaved, "Название...", "", 5)
    local emoIdInp = CreateTextBox(vEmotesSaved, "ID Анимации...", "", 6)

    CreateButton(vEmotesSaved, "➕ Добавить / Переименовать", function()
        local n, i = emoNameInp.Text, emoIdInp.Text
        if n ~= "" and i ~= "" then
            local exists = false
            for _, v in ipairs(customAnims) do if v.id == i then v.name = n exists = true break end end
            if not exists then table.insert(customAnims, {name = n, id = i}) end
            saveData() renderEmotesUI() emoNameInp.Text = "" emoIdInp.Text = "" showNotice(exists and "Эмоция переименована!" or "Эмоция добавлена!")
        end
    end, Color3.fromRGB(40, 120, 200), 7)
end

-- ================== 2. ДВИЖЕНИЯ (ТОЛЬКО КАСТОМНЫЕ) ==================
do
    local MoveTop = make("Frame", {Size = UDim2.new(1, -10, 0, 30), BackgroundTransparency = 1}, vMove)
    local btnMoveSearch = make("TextButton", {Size = UDim2.new(0.5, -5, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 120, 200), Text = "🔍 Поиск Паков", TextColor3 = Color3.fromRGB(255,255,255), Font = Enum.Font.GothamBold, TextSize = 12}, MoveTop) addCorner(btnMoveSearch, 6)
    local btnMoveSaved = make("TextButton", {Size = UDim2.new(0.5, -5, 1, 0), Position = UDim2.new(0.5, 5, 0, 0), BackgroundColor3 = Color3.fromRGB(25, 25, 32), Text = "⭐ Сохраненные", TextColor3 = Color3.fromRGB(200,200,200), Font = Enum.Font.GothamBold, TextSize = 12}, MoveTop) addCorner(btnMoveSaved, 6)

    local vMoveSearch = make("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -35), Position = UDim2.new(0, 0, 0, 35), BackgroundTransparency = 1, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0,0,0,0)}, vMove)
    local vMoveSaved = make("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -35), Position = UDim2.new(0, 0, 0, 35), BackgroundTransparency = 1, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0,0,0,0), Visible = false}, vMove)

    btnMoveSearch.MouseButton1Click:Connect(function()
        vMoveSearch.Visible = true vMoveSaved.Visible = false
        tween(btnMoveSearch, 0.2, {BackgroundColor3 = Color3.fromRGB(40, 120, 200), TextColor3 = Color3.fromRGB(255,255,255)})
        tween(btnMoveSaved, 0.2, {BackgroundColor3 = Color3.fromRGB(25, 25, 32), TextColor3 = Color3.fromRGB(200,200,200)})
    end)
    btnMoveSaved.MouseButton1Click:Connect(function()
        vMoveSaved.Visible = true vMoveSearch.Visible = false
        tween(btnMoveSaved, 0.2, {BackgroundColor3 = Color3.fromRGB(40, 120, 200), TextColor3 = Color3.fromRGB(255,255,255)})
        tween(btnMoveSearch, 0.2, {BackgroundColor3 = Color3.fromRGB(25, 25, 32), TextColor3 = Color3.fromRGB(200,200,200)})
    end)

    local function setMove(st, an, id) 
        if not id or id == "" then return end 
        local c = player.Character 
        if c and c:FindFirstChild("Animate") then 
            local o = c.Animate:FindFirstChild(st) 
            if o and o:FindFirstChild(an) then 
                local animIdToPlay = string.match(id, "^rbxassetid://") and id or "rbxassetid://"..id
                pcall(function()
                    local rawId = string.match(id, "%d+")
                    local objects = game:GetObjects("rbxassetid://" .. rawId)
                    if objects and objects[1] then
                        local animObj = objects[1]:IsA("Animation") and objects[1] or objects[1]:FindFirstChildWhichIsA("Animation", true)
                        if animObj then animIdToPlay = animObj.AnimationId end
                    end
                end)
                o[an].AnimationId = animIdToPlay 
            end 
        end 
    end

    local function applyMove(i, w, r, j, f) 
        setMove("idle", "Animation1", i) 
        setMove("idle", "Animation2", i) 
        setMove("walk", "WalkAnim", w) 
        setMove("run", "RunAnim", r) 
        setMove("jump", "JumpAnim", j) 
        setMove("fall", "FallAnim", f) 
    end

    local function applyBundle(bundleId, bundleName)
        showNotice("Распаковка пака " .. bundleName .. "...")
        task.spawn(function()
            local s2, details = pcall(function() return AssetService:GetBundleDetailsAsync(bundleId) end)
            if s2 and details and details.Items then
                local idleId, walkId, runId, jumpId, fallId
                for _, subItem in ipairs(details.Items) do
                    local n = subItem.Name:lower()
                    local idStr = tostring(subItem.Id)
                    if n:find("idle") then idleId = idStr
                    elseif n:find("walk") then walkId = idStr
                    elseif n:find("run") then runId = idStr
                    elseif n:find("jump") then jumpId = idStr
                    elseif n:find("fall") or n:find("pose") then fallId = idStr end
                end
                idleId = idleId or details.Items[1] and tostring(details.Items[1].Id)
                walkId = walkId or idleId runId = runId or walkId jumpId = jumpId or idleId fallId = fallId or jumpId
                mySetts.selectedPackData = {idleId, walkId, runId, jumpId, fallId}
                saveData() applyMove(idleId, walkId, runId, jumpId, fallId)
                showNotice("Пак " .. bundleName .. " успешно применен!")
            else showNotice("⚠️ Не удалось распаковать пак!") end
        end)
    end

    make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)}, vMoveSearch)
    local bundleSearchRow = make("Frame", {Size = UDim2.new(1, -10, 0, 35), BackgroundTransparency = 1, LayoutOrder = 1}, vMoveSearch)
    local bundleInp = make("TextBox", {Size = UDim2.new(0.65, -5, 1, 0), BackgroundColor3 = Color3.fromRGB(20, 20, 26), PlaceholderText = "Англ. название (напр: Ninja, Superhero)...", Text = "", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.Gotham, TextSize = 12}, bundleSearchRow) addCorner(bundleInp, 6)
    local bundleBtn = make("TextButton", {Size = UDim2.new(0.35, 0, 1, 0), Position = UDim2.new(0.65, 5, 0, 0), BackgroundColor3 = Color3.fromRGB(150, 50, 200), Text = "Найти Пак", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 12}, bundleSearchRow) addCorner(bundleBtn, 6)

    local bundleResultsContainer = make("Frame", {Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2}, vMoveSearch)
    make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5)}, bundleResultsContainer)

    local function renderMoveUI() end 
    
    local function createBundleSearchRow(bundleId, bundleName)
        local Row = make("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = Color3.fromRGB(25, 25, 32)}, bundleResultsContainer) addCorner(Row, 6)
        local Icon = make("ImageLabel", {Size = UDim2.new(0, 36, 0, 36), Position = UDim2.new(0, 4, 0.5, -18), BackgroundColor3 = Color3.fromRGB(40,40,45), BackgroundTransparency = 0, Image = "rbxthumb://type=Bundle&id=" .. tostring(bundleId) .. "&w=150&h=150"}, Row) addCorner(Icon, 6)
        local nameLbl = make("TextLabel", {Size = UDim2.new(0.55, -45, 1, 0), Position = UDim2.new(0, 45, 0, 0), BackgroundTransparency=1, TextColor3=Color3.fromRGB(255,255,255), Text=bundleName, Font=Enum.Font.Gotham, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd}, Row)
        
        local applyBtn = make("TextButton", {Size=UDim2.new(0.2, 0, 0, 28), Position=UDim2.new(0.55, 0, 0.5, -14), BackgroundColor3=Color3.fromRGB(40,160,60), Text="✨ Прим.", TextColor3=Color3.fromRGB(255,255,255), Font=Enum.Font.GothamBold, TextSize=10}, Row) addCorner(applyBtn, 4)
        local saveCatBtn = make("TextButton", {Size=UDim2.new(0.2, 0, 0, 28), Position=UDim2.new(0.78, 0, 0.5, -14), BackgroundColor3=Color3.fromRGB(40,120,200), Text="➕ Сохр.", TextColor3=Color3.fromRGB(255,255,255), Font=Enum.Font.GothamBold, TextSize=10}, Row) addCorner(saveCatBtn, 4)

        applyBtn.MouseButton1Click:Connect(function() applyBundle(bundleId, bundleName) end)
        saveCatBtn.MouseButton1Click:Connect(function() 
            local exists = false
            for _, v in ipairs(customPacks) do if v.id == tostring(bundleId) then exists = true break end end
            if not exists then 
                table.insert(customPacks, {name = bundleName, id = tostring(bundleId)}) 
                saveData() renderMoveUI() showNotice("Пак сохранен!") 
            else showNotice("Уже в списке!") end
        end)
    end

    bundleBtn.MouseButton1Click:Connect(function()
        for _, child in ipairs(bundleResultsContainer:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
        local q = bundleInp.Text if q == "" then return end
        showNotice("Ищем паки анимаций...")
        task.spawn(function()
            local url = "https://catalog.roproxy.com/v1/search/items/details?Category=12&Subcategory=38&Limit=15&Keyword=" .. Http:UrlEncode(q)
            local s, r = pcall(function() return game:HttpGet(url) end)
            if s and r then
                local decoded = Http:JSONDecode(r)
                if decoded and decoded.data and #decoded.data > 0 then
                    showNotice("Найдено результатов: " .. #decoded.data)
                    for _, item in ipairs(decoded.data) do createBundleSearchRow(item.id, item.name) end
                    return
                end
            end
            showNotice("Пробуем запасной метод поиска...")
            local s2, r2 = pcall(function()
                local searchParams = CatalogSearchParams.new()
                searchParams.SearchKeyword = q
                searchParams.BundleTypes = {Enum.BundleType.Animations}
                searchParams.SortType = Enum.CatalogSortType.Relevance
                return AvatarEditorService:SearchCatalog(searchParams)
            end)
            if s2 and r2 then
                local items = r2:GetCurrentPage()
                if #items > 0 then
                    showNotice("Найдено результатов: " .. #items)
                    for _, item in ipairs(items) do createBundleSearchRow(item.Id, item.Name) end
                else showNotice("Паки по этому запросу не найдены!") end
            else showNotice("Все методы поиска заблокированы Роблоксом!") end
        end)
    end)

    make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)}, vMoveSaved)
    CreateButton(vMoveSaved, "Сбросить анимацию (Ресет)", function() mySetts.selectedPackData = nil saveData() showNotice("Сброшено! Ресетнись.") end, Color3.fromRGB(180, 50, 50), 1)

    local packsContainer = make("Frame", {Size = UDim2.new(1,-10,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2}, vMoveSaved)
    make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5)}, packsContainer)

    local function createPackRow(name, bundleId, isCust, manualData)
        local Row = make("Frame", {Size = UDim2.new(1, 0, 0, 35), BackgroundTransparency = 1}, packsContainer)
        local PlayBtn = make("TextButton", {Size = UDim2.new(1, -45, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 40, 48), Text = "⭐ " .. name, TextColor3 = Color3.fromRGB(220, 220, 220), Font = Enum.Font.GothamSemibold, TextSize = 13}, Row) addCorner(PlayBtn, 6)

        if manualData then
            PlayBtn.MouseButton1Click:Connect(function()
                mySetts.selectedPackData = manualData
                saveData() applyMove(unpack(manualData)) showNotice("Пак применен!")
            end)
        else
            PlayBtn.MouseButton1Click:Connect(function() applyBundle(tonumber(bundleId), name) end)
        end

        local DelBtn = make("TextButton", {Size = UDim2.new(0, 40, 1, 0), Position = UDim2.new(1, -40, 0, 0), BackgroundColor3 = Color3.fromRGB(180, 50, 50), Text = "🗑️", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 12}, Row) addCorner(DelBtn, 6)
        DelBtn.MouseButton1Click:Connect(function() 
            for i, v in ipairs(customPacks) do if v.id == bundleId then table.remove(customPacks, i) break end end 
            saveData() Row:Destroy()
        end)
    end

    renderMoveUI = function()
        for _, child in ipairs(packsContainer:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
        for _, v in ipairs(customPacks) do createPackRow(v.name, v.id, true, v.isManual and v.data or nil) end
    end
    renderMoveUI()

    CreateLabel(vMoveSaved, "Свои ID движений (Ручной ввод / Сохранение)", 3)
    local mName = CreateTextBox(vMoveSaved, "Название для сохранения пака...", "", 4)
    local mI = CreateTextBox(vMoveSaved, "Idle ID", "", 5)
    local mW = CreateTextBox(vMoveSaved, "Walk ID", "", 6)
    local mR = CreateTextBox(vMoveSaved, "Run ID", "", 7)
    local mJ = CreateTextBox(vMoveSaved, "Jump ID", "", 8)
    local mF = CreateTextBox(vMoveSaved, "Fall ID", "", 9)

    local manualActionRow = make("Frame", {Size = UDim2.new(1, -10, 0, 35), BackgroundTransparency = 1, LayoutOrder = 10}, vMoveSaved)
