-- Функция определения ролей (глобальная для Аимбота и ESP)
local function getRoleInfo(p)
    if mm2EarlyRoles[p.Name] then
        local r = mm2EarlyRoles[p.Name]
        if r == "Murderer" then return "MURDERER", C3(255, 50, 50) end
        if r == "Sheriff" or r == "Hero" then return "SHERIFF", C3(50, 150, 255) end
        return "Innocent", C3(50, 255, 50)
    end
    
    local bp = p:FindFirstChild("Backpack") 
    local char = p.Character 
    local mur, sher = false, false
    local function c(f)
        if not f then return end
        for _, v in ipairs(f:GetChildren()) do 
            if v:IsA("Tool") then 
                if v.Name == "Knife" then mur = true end 
                if v.Name == "Gun" or v.Name == "Revolver" then sher = true end 
            end 
        end
    end
    c(bp) c(char)
    if mur then return "MURDERER", C3(255, 50, 50) end
    if sher then return "SHERIFF", C3(50, 150, 255) end
    return "Innocent", C3(50, 255, 50)
end

-- ================== УЛЬТИМАТИВНЫЙ SILENT AIM (ХУК МЫШИ) ==================
if hookmetamethod then
    pcall(function()
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", function(t, k)
            if not checkcaller() and isCamAimbot and isAiming then
                if typeof(t) == "Instance" and t:IsA("Mouse") then
                    if k == "Hit" or k == "Target" or k == "p" or k == "X" or k == "Y" or k == "Z" then
                        local murdChar = nil
                        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                            if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                                local role, _ = getRoleInfo(p)
                                if role == "MURDERER" then
                                    murdChar = p.Character
                                    break
                                end
                            end
                        end
                        if murdChar then
                            local part = murdChar:FindFirstChild("Torso") or murdChar:FindFirstChild("UpperTorso") or murdChar:FindFirstChild("Head")
                            if part and part.Parent then
                                if k == "Hit" then return part.CFrame end
                                if k == "p" then return part.Position end
                                if k == "X" then return part.Position.X end
                                if k == "Y" then return part.Position.Y end
                                if k == "Z" then return part.Position.Z end
                                if k == "Target" then return part end
                            end
                        end
                    end
                end
            end
            return oldIndex(t, k)
        end)
    end)
end

