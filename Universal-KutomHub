-- ================== УНИВЕРСАЛЬНЫЙ ФЛИНГ ==================
local setAntiFlingState

local function stopFling()
    isFling = false flingTarget = nil
    if flingConn then flingConn:Disconnect() flingConn = nil end
    pcall(function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hrp then 
            hrp.Velocity = Vector3.zero hrp.RotVelocity = Vector3.zero 
            if hrp:FindFirstChild("KutomFling") then hrp.KutomFling:Destroy() end
            if returnPosition then hrp.CFrame = returnPosition returnPosition = nil end
            for _, v in ipairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = true end end
        end
        if hum then hum.PlatformStand = false end
    end)
end

local function startFling(t)
    if not t or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    stopFling()
    
    returnPosition = player.Character.HumanoidRootPart.CFrame
    flingTarget = t
    isFling = true
    
    if not isAntiFling and setAntiFlingState then setAntiFlingState(true) end

    player.Character:FindFirstChildOfClass("Humanoid").PlatformStand = true
    local spin = Instance.new("BodyAngularVelocity", player.Character.HumanoidRootPart)
    spin.Name = "KutomFling" spin.AngularVelocity = Vector3.new(0, 99999, 0) spin.MaxTorque = Vector3.new(0, math.huge, 0) spin.P = math.huge
    
    flingConn = RS.Stepped:Connect(function()
        if not isFling or not flingTarget or not player.Character or not player.Character.Parent then return end
        pcall(function()
            local tChar = flingTarget.Character
            local tHrp = tChar and (tChar:FindFirstChild("Torso") or tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("HumanoidRootPart"))
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            
            if hrp and tHrp and tHum and tHum.Health > 0 then
                for _, v in ipairs(player.Character:GetChildren()) do if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then v.CanCollide = false end end
                hrp.CanCollide = true 
                -- Агрессивный физический импульс
                hrp.Velocity = Vector3.new(math.random(-100, 100), 10000, math.random(-100, 100)) 
                hrp.RotVelocity = Vector3.new(20000, 20000, 20000) 
                hrp.CFrame = tHrp.CFrame * CFrame.new(math.random(-1,1), math.random(-1,1), math.random(-1,1))
            else
                showNotice("✅ Цель устранена или вышла!")
                stopFling()
            end
        end)
    end)
end

