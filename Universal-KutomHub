UIS.InputBegan:Connect(function(inp, gp)
    if isBindingLoc and inp.UserInputType == Enum.UserInputType.Keyboard then
        local k = inp.KeyCode.Name 
        if k == "Escape" or k == "Backspace" then binds[bindIdLoc] = nil else binds[bindIdLoc] = k end
        
        if bindBtnLoc then
            bindBtnLoc.Text = binds[bindIdLoc] and ("["..binds[bindIdLoc].."]") or "None"
            bindBtnLoc.TextColor3 = binds[bindIdLoc] and Color3.fromRGB(150, 255, 150) or Color3.fromRGB(200, 200, 200)
        end
        isBindingLoc = false saveData() return
    end

    if gp then return end
    
    if inp.UserInputType == Enum.UserInputType.Keyboard then
        local k = inp.KeyCode.Name
        if k == "Insert" then toggleMenu() return end
        
        for id, bk in pairs(binds) do
            if bk == k then
                if id == "VIP_Fly" then 
                    toggleFly() 
                elseif id == "Other_FastReset" then 
                    if doFastReset then doFastReset() end
                elseif string.sub(id, 1, 3) == "TP_" then 
                    local tName = string.sub(id, 4) 
                    if teleports[tName] then tpToPos(CFrame.new(unpack(teleports[tName].pos))) end 
                else 
                    if playAnim then playAnim(id) end
                end 
                break
            end
        end
    end
end)

local function CreateToggleWithBind(page, text, bindId, initialState, callback, layoutOrder)
