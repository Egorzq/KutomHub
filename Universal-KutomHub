-- ================== UI HELPER ==================
local function make(cls, props, parent)
    local obj = Instance.new(cls)
    for k, v in pairs(props) do obj[k] = v end
    if parent then obj.Parent = parent end return obj
end

local function addCorner(p, r) 
    return make("UICorner", {CornerRadius = UDim.new(0, r)}, p) 
end

local function addStroke(p, c, t) 
    return make("UIStroke", {Color = c, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p) 
end

local function tween(obj, t, props) 
    if obj and TS then 
        TS:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play() 
    end 
end

local function setupBind(btn, id)
    local k = binds[id] 
    if btn then 
        btn.Text = k and ("["..k.."]") or "[ - ]" 
        btn.TextColor3 = k and C3(150, 255, 150) or C3(150, 150, 150) 
    end
    if btn then 
        btn.MouseButton1Click:Connect(function() 
            if isBind then return end 
            isBind = true 
            bindId = id 
            bindBtnObj = btn 
            btn.Text = "[...]" 
            tween(btn, 0.2, {TextColor3 = C3(255, 200, 50)})
        end) 
    end
end

