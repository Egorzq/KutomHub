-- Функция определения ролей
local function getRoleInfo(p)
    if mm2EarlyRoles[p.Name] then
        local r = mm2EarlyRoles[p.Name]
        if r == "Murderer" then return "MURDERER", Color3.fromRGB(255, 50, 50) end
        if r == "Sheriff" or r == "Hero" then return "SHERIFF", Color3.fromRGB(50, 150, 255) end
        return "Innocent", Color3.fromRGB(50, 255, 50)
    end
    local bp = p:FindFirstChild("Backpack") 
    local char = p.Character 
    local mur, sher = false, false
    local function c(f)
        if not f then return end
        for _, v in ipairs(f:GetChildren()) do 
            if v:IsA("Tool") then 
                if v.Name == "Knife" then mur = true end 
                if v.Name == "Gun" or v.Name == "Revolver" then sher = true end 
            end 
        end
    end
    c(bp) c(char)
    if mur then return "MURDERER", Color3.fromRGB(255, 50, 50) end
    if sher then return "SHERIFF", Color3.fromRGB(50, 150, 255) end
    return "Innocent", Color3.fromRGB(50, 255, 50)
end

