    local ToggleBtn = make("TextButton", {Size = UDim2.new(1, bindId and -50 or 0, 1, 0), BackgroundColor3 = initialState and Color3.fromRGB(40, 160, 60) or Color3.fromRGB(25, 25, 32), Text = text .. (initialState and ": ВКЛ" or ": ВЫКЛ"), TextColor3 = Color3.fromRGB(220, 220, 220), Font = Enum.Font.GothamBold, TextSize = 12}, Row)
    addCorner(ToggleBtn, 6)
    
