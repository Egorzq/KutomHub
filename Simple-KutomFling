-- Логика закрытия
CloseButton.MouseButton1Click:Connect(function()
    local tween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1})
    tween:Play()
    tween.Completed:Wait()
    ScreenGui:Destroy()
end)

-- Логика WalkFling
local walkflinging = false
WalkFlingButton.MouseButton1Click:Connect(function()
    walkflinging = not walkflinging
    
    if walkflinging then
        StatusLabel.Text = "Статус: Активен"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        
        TweenService:Create(WalkFlingButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 255, 200)}):Play()
        TweenService:Create(WalkFlingButton, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(15, 15, 25)}):Play()
        TweenService:Create(UIStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 100)}):Play()
        
        task.spawn(function()
            for _, child in next, LocalPlayer.Character:GetDescendants() do
                if child:IsA("BasePart") then
                    child.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
                    child.CanCollide = false
                end
            end
            
            while walkflinging do
                RunService.Heartbeat:Wait()
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                if not (character and character.Parent and root and root.Parent) then continue end
                
                local vel = root.Velocity
                root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                RunService.RenderStepped:Wait()
                if character and character.Parent and root and root.Parent then
                    root.Velocity = vel
                end
                RunService.Stepped:Wait()
                if character and character.Parent and root and root.Parent then
                    root.Velocity = vel + Vector3.new(0, 0.1, 0)
                end
            end
        end)
    else
        StatusLabel.Text = "Статус: Выключен"
        StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 180)
        
        TweenService:Create(WalkFlingButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 40)}):Play()
        TweenService:Create(WalkFlingButton, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(0, 255, 200)}):Play()
        TweenService:Create(UIStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 200)}):Play()
        
        if LocalPlayer.Character then
            for _, v in next, LocalPlayer.Character:GetDescendants() do
                if v:IsA("BasePart") then
                    v.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
                    v.Velocity = Vector3.zero
                    v.CanCollide = true
                end
            end
        end
    end
end)
