-- Функция поиска игрока по полному нику или его части
local function getTargetPlayer(nameInput)
    nameInput = nameInput:lower()
    if nameInput == "" then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name:lower()
            local pDisp = player.DisplayName:lower()
            if pName:sub(1, #nameInput) == nameInput or pDisp:sub(1, #nameInput) == nameInput then
                return player
            end
        end
    end
    return nil
end

-- Логика WalkFling с телепортацией и возвратом
local walkflinging = false
local originalPosition = nil

WalkFlingButton.MouseButton1Click:Connect(function()
    walkflinging = not walkflinging
    
    if walkflinging then
        local targetPlayer = getTargetPlayer(TargetBox.Text)
        if not targetPlayer then
            walkflinging = false
            StatusLabel.Text = "Ошибка: Игрок не найден!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            return
        end
        
        -- Сохраняем исходную позицию перед телепортацией
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            originalPosition = root.CFrame
        else
            walkflinging = false
            StatusLabel.Text = "Ошибка: Персонаж не загружен!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            return
        end
        
        StatusLabel.Text = "Статус: Флинг (" .. targetPlayer.Name .. ")"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        
        TweenService:Create(WalkFlingButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 255, 200)}):Play()
        TweenService:Create(WalkFlingButton, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(15, 15, 25)}):Play()
        TweenService:Create(UIStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 100)}):Play()
        
        task.spawn(function()
            for _, child in next, LocalPlayer.Character:GetDescendants() do
                if child:IsA("BasePart") then
                    child.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
                    child.CanCollide = false
                end
            end
            
            while walkflinging do
                RunService.Heartbeat:Wait()
                
                local character = LocalPlayer.Character
                local myRoot = character and character:FindFirstChild("HumanoidRootPart")
                local targetChar = targetPlayer.Character
                local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                
                if character and character.Parent and myRoot and myRoot.Parent and targetRoot then
                    -- Постоянно телепортируемся к цели и крутим физику
                    myRoot.CFrame = targetRoot.CFrame
                    
                    local vel = myRoot.Velocity
                    myRoot.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                    RunService.RenderStepped:Wait()
                    if character and character.Parent and myRoot and myRoot.Parent then
                        myRoot.Velocity = vel
                    end
                    RunService.Stepped:Wait()
                    if character and character.Parent and myRoot and myRoot.Parent then
                        myRoot.Velocity = vel + Vector3.new(0, 0.1, 0)
                    end
                end
            end
        end)
    else
        StatusLabel.Text = "Статус: Выключен"
        StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 180)
        
        TweenService:Create(WalkFlingButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 40)}):Play()
        TweenService:Create(WalkFlingButton, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(0, 255, 200)}):Play()
        TweenService:Create(UIStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 200)}):Play()
        
        if LocalPlayer.Character then
            local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            -- Возвращаем на исходное место, если оно сохранено
            if root and originalPosition then
                root.CFrame = originalPosition
                root.Velocity = Vector3.zero
            end
            
            for _, v in next, LocalPlayer.Character:GetDescendants() do
                if v:IsA("BasePart") then
                    v.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
                    v.Velocity = Vector3.zero
                    
                    if v.Name == "Handle" or v:IsA("Accessory") or v.Parent:IsA("Accessory") then
                        v.CanCollide = false
                    else
                        v.CanCollide = true
                    end
                end
            end
        end
    end
end)
