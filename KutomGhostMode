-- ==========================================
-- KUTOM GHOST MODE (STANDALONE SCRIPT)
-- ==========================================
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Создаем мини-меню, которое можно таскать по экрану
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "KutomGhostGui"
ScreenGui.ResetOnSpawn = false
pcall(function() ScreenGui.Parent = game:GetService("CoreGui") end)
if not ScreenGui.Parent then ScreenGui.Parent = player:WaitForChild("PlayerGui") end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 160, 0, 40)
MainFrame.Position = UDim2.new(0.5, -80, 0, 20)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 6)
UICorner.Parent = MainFrame

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(150, 50, 200)
UIStroke.Thickness = 2
UIStroke.Parent = MainFrame

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(1, 0, 1, 0)
ToggleBtn.BackgroundTransparency = 1
ToggleBtn.Text = "👻 Ghost: OFF"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.TextSize = 14
ToggleBtn.Parent = MainFrame

local isGhost = false
local realChar = nil
local fakeChar = nil

ToggleBtn.MouseButton1Click:Connect(function()
    if not isGhost then
        -- ВКЛЮЧАЕМ НЕВИДИМОСТЬ
        realChar = player.Character
        if not realChar or not realChar:FindFirstChild("HumanoidRootPart") then return end
        
        realChar.Archivable = true
        fakeChar = realChar:Clone()
        fakeChar.Name = player.Name .. "_GhostClone"
        fakeChar.Parent = workspace
        
        -- Прячем настоящего персонажа высоко в небе и делаем прозрачным
        realChar.HumanoidRootPart.CFrame = realChar.HumanoidRootPart.CFrame * CFrame.new(0, 150, 0)
        for _, v in ipairs(realChar:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
                if v.Name == "HumanoidRootPart" then v.Anchored = true end
            end
        end
        
        -- Передаем управление клону
        player.Character = fakeChar
        workspace.CurrentCamera.CameraSubject = fakeChar:WaitForChild("Humanoid")
        
        ToggleBtn.Text = "👻 Ghost: ON"
        UIStroke.Color = Color3.fromRGB(50, 200, 50)
        isGhost = true
    else
        -- ВЫКЛЮЧАЕМ НЕВИДИМОСТЬ
        if fakeChar then fakeChar:Destroy() end
        if realChar and realChar:FindFirstChild("HumanoidRootPart") then
            player.Character = realChar
            
            -- Возвращаем видимость
            for _, v in ipairs(realChar:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    v.Transparency = 0
                end
            end
            
            realChar.HumanoidRootPart.Anchored = false
            -- Телепортируем настоящего туда, где стоял клон
            if workspace.CurrentCamera.Focus then
                realChar.HumanoidRootPart.CFrame = workspace.CurrentCamera.Focus
            end
            workspace.CurrentCamera.CameraSubject = realChar:WaitForChild("Humanoid")
        end
        
        ToggleBtn.Text = "👻 Ghost: OFF"
        UIStroke.Color = Color3.fromRGB(150, 50, 200)
        isGhost = false
    end
end)
